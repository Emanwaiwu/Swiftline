# Resend API key for sending lead notification emails
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where lead notification emails should be sent
# This is the address that receives form submissions.
LEAD_NOTIFICATION_EMAIL=eman@getswiftline.com

# Verified sender domain in Resend
# This must be an address at a domain you've verified in your Resend account.
# You don't need to actually create the inbox - it just needs to be on a verified domain.
LEAD_FROM_EMAIL=notifications@getswiftline.com
